# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Claude Code local settings
.claude/settings.local.json

# sensitive files
.env
.env.local

# presentation files
*.pptx
*.ppt
*.pdf

# Helm dependency archives (baixados por helm dependency build)
infra/charts/*/charts/*.tgz

# Cluster state — PVC data and Vault init output (never commit)
.data/

# MLflow local tracking store (created when running training/tests without a
# tracking URI override)
mlruns/
.pytest_cache/
