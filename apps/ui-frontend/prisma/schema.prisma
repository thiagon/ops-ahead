// The configuration registry behind the Ajustes screens. This database belongs
// to the frontend: nothing else reads or writes it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CONFIG_DATABASE_URL")
}

/// Shared by every registry row. `inactive` stays in the list that shows
/// it; `archived` leaves that list. Rows are never deleted.
enum Status {
  active
  inactive
  archived
}

enum Intake {
  monitor
  alert
}

/// A customer this deployment may serve. Numeric `id` is the foreign key;
/// `slug` is unique and is what URLs / ClickHouse `tenant_id` carry;
/// `name` is the display label (accents allowed, not unique).
model Tenant {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  /// Lifecycle of this tenant in the registry.
  status    Status @default(active)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  origins    Origin[]
  deadlines  Deadline[]
  kpiTargets KpiTarget[]
  revisions  Revision[]

  @@map("config_tenants")
}

/// An origin the tenant sends events from, named by the customer.
model Origin {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  source          String
  intake          Intake
  envelopeVersion String    @map("envelope_version")
  status          Status @default(inactive)
  /// Only when the key was minted — the key itself is never stored.
  secretCreatedAt DateTime? @map("secret_created_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bindings   FieldBinding[]
  mappings   Mapping[]
  dictionary DictionaryVersion?

  @@unique([tenantId, source])
  @@map("config_origins")
}

/// Where each field of the translated contract is read in the origin's payload.
model FieldBinding {
  id        Int      @id @default(autoincrement())
  originId  Int      @map("origin_id")
  field     String
  path      String?
  status    Status @default(active)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  origin Origin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@unique([originId, field])
  @@map("config_field_bindings")
}

/// One origin value mapped to one domain value. Several origin values may land
/// on the same domain value, never the reverse — hence the unique on the origin side.
model Mapping {
  id           Int      @id @default(autoincrement())
  originId     Int      @map("origin_id")
  mappingField String   @map("mapping_field")
  fromValue    String   @map("from_value")
  toValue      String   @map("to_value")
  status       Status @default(active)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  origin Origin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@unique([originId, mappingField, fromValue])
  @@map("config_mappings")
}

model DictionaryVersion {
  id        Int      @id @default(autoincrement())
  originId  Int      @unique @map("origin_id")
  version   String
  /// `inactive` until Publicar; `active` once the fields are committed.
  status    Status @default(inactive)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  origin Origin @relation(fields: [originId], references: [id], onDelete: Cascade)

  @@map("config_dictionary_versions")
}

model Deadline {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  severity        Int      @db.SmallInt
  deadlineSeconds Int      @map("deadline_seconds")
  status          Status @default(active)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, severity])
  @@map("config_deadlines")
}

/// One annual band. The group is the severities that share the quota
/// (`{1,2}` for P1+P2, `{3}` for P3) — the band is part of the unique.
model KpiTarget {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  severities     Int[]
  maxBreaches    Int      @map("max_breaches")
  achievementPct Decimal  @map("achievement_pct") @db.Decimal(5, 2)
  status         Status @default(active)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, severities, achievementPct])
  @@map("config_kpi_targets")
}

/// Append-only: `payload` is the state as it stood before the change, which is
/// what a rollback restores.
model Revision {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  domain    String
  configKey String   @map("config_key")
  summary   String
  author    String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("config_revisions")
}
