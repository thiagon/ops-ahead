{
  "name": "@ops-ahead/ui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard front end — React Router framework mode; server-side loaders read the ClickHouse gold layer and no database credential ever reaches the browser (ns:ui)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@prisma/client": "6.19.0",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "isbot": "5.2.1",
    "prisma": "6.19.0",
    "prom-client": "15.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
