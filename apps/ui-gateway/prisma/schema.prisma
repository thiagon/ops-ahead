// Status of an on-demand analysis, plus who the gateway lets in. The gateway
// owns this database; trainers PATCH /analyses/{id} with the run key from the
// Kafka message — only the hash is stored here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  pending
  running
  succeeded
  failed
}

/// The client a source, mapping, deadline set or target set belongs to. The
/// id is the same string the URL carries (domain/ubiquitous-language.md#tenant)
/// and the same name the Authentik group carries: the group is what says a
/// tenant exists and who may act for it, so a row here is materialized the
/// first time one is seen, never authored.
model Tenant {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  sources   Source[]
  deadlines Deadline[]
  targets   Target[]

  @@map("tenants")
}

/// A system the gateway accepts events from, named by the tenant it belongs
/// to. The secret is stored encrypted (services/sources/cipher.ts) rather
/// than hashed: verifying a signature means recomputing it, which needs the
/// secret itself.
model Source {
  tenantId        String       @map("tenant_id")
  name            String
  intake          Intake
  status          SourceStatus @default(active)
  encryptedSecret String       @map("encrypted_secret")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  mappings Mapping[]

  @@id([tenantId, name])
  @@map("sources")
}

enum Intake {
  alert
  monitor
}

/// A disabled source keeps its configuration and its secret; it just stops
/// being answered, so turning it back on is one call and no re-registration.
enum SourceStatus {
  active
  disabled
}

/// How an analysis came to run. `manual` is a caller asking for it, `scheduled`
/// the daily CronJob, `chained` a training data-runner started off a finished
/// full_pipeline. Three values rather than two: a chained run is neither — the
/// clock did not ask for it, the transformation's own success did.
enum AnalysisTrigger {
  manual
  scheduled
  chained
}

model Analysis {
  id            String          @id
  analysis      String
  /// Null for the data analyses, which rebuild every mart at once. Set on a
  /// training, where there is one model per tenant and a run without an owner
  /// could answer neither "whose model is this" nor "retrain just this one".
  tenantId      String?         @map("tenant_id")
  trigger       AnalysisTrigger @default(manual)
  status        AnalysisStatus  @default(pending)
  runKeyHash    String          @unique @map("run_key_hash")
  startedAt     DateTime?       @map("started_at") @db.Timestamptz()
  finishedAt    DateTime?       @map("finished_at") @db.Timestamptz()
  detail        Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  /// The full_pipeline run a chained training was started from, so "which
  /// models did this data produce" is a query rather than a log search.
  parentId String?    @map("parent_id")
  parent   Analysis?  @relation("AnalysisChain", fields: [parentId], references: [id])
  children Analysis[] @relation("AnalysisChain")

  @@index([trigger, createdAt])
  @@index([tenantId, createdAt])
  @@index([analysis, createdAt])
  @@map("analyses")
}

/// What the clock authenticates with. Only the hash is stored; the prefix is
/// there so a log line can name the key without revealing it.
model ApiKey {
  id        String     @id @default(uuid())
  kind      ApiKeyKind
  prefix    String
  hash      String     @unique
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt DateTime?  @map("revoked_at") @db.Timestamptz()

  @@map("api_keys")
}

/// One kind, and it is the CronJob's. The consumers authenticate with the run
/// key of the message they received, so there is no key to issue them.
enum ApiKeyKind {
  scheduler
}

/// A published origin mapping. A later PUT inserts another row. GET lists
/// the last ten; older copies stay in the table. The pair (tenant, source)
/// must already exist as a Source.
model Mapping {
  id                Int      @id @default(autoincrement())
  tenantId          String   @map("tenant_id")
  source            String
  intake            Intake
  version           String
  bindings          Json
  mappings          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  sourceRecord      Source   @relation(fields: [tenantId, source], references: [tenantId, name])

  @@index([tenantId, source, createdAt])
  @@map("mappings")
}

/// A published deadline set for a tenant. GET lists the last ten.
model Deadline {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  deadlines Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("deadlines")
}

/// A published KPI target set for a tenant. GET lists the last ten.
model Target {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  targets   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("targets")
}
