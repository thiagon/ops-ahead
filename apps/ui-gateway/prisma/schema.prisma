// Status of an on-demand analysis. The gateway owns this database; trainers
// PATCH /analyses/{id} with the update key from the Kafka message — only the
// hash is stored here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStatus {
  pending
  running
  succeeded
  failed
}

/// An origin the gateway accepts events from. The secret is stored encrypted
/// (services/origins/cipher.ts) rather than hashed: verifying a signature
/// means recomputing it, which needs the secret itself.
model Origin {
  tenantId        String   @map("tenant_id")
  source          String
  intake          Intake
  encryptedSecret String   @map("encrypted_secret")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@id([tenantId, source])
  @@map("origins")
}

enum Intake {
  alert
  monitor
}

model Analysis {
  id            String         @id
  status        AnalysisStatus @default(pending)
  updateKeyHash String         @map("update_key_hash")
  startedAt     DateTime?      @map("started_at") @db.Timestamptz()
  finishedAt    DateTime?      @map("finished_at") @db.Timestamptz()
  detail        Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("analyses")
}
