{
  "name": "@ops-ahead/ui-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ingestion gateway (Motor de Integração) — HTTP boundary that normalizes ITSM webhooks into incidents.received (ns:ui)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@fastify/autoload": "6.5.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "close-with-grace": "2.5.0",
    "fastify": "5.11.0",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "kafkajs": "2.2.4",
    "prom-client": "15.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
