GITHUB_PERSONAL_ACCESS_TOKEN=

# ─── Browser ─────────────────────────────────────────────────────────────────
CHROME_BIN=/usr/bin/google-chrome

# ─── Vault ───────────────────────────────────────────────────────────────────
VAULT_TOKEN=ops-ahead-dev

# ─── Gitea (dev local — espelho do repo pro ArgoCD ler) ──────────────────────
GITEA_ADMIN_PASSWORD=ops-ahead-dev

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_MLFLOW_PASSWORD=mlflow

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=ops-ahead-dev

# ─── MLflow ──────────────────────────────────────────────────────────────────
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=ops-ahead-dev
MLFLOW_CRYPTO_KEK_PASSPHRASE=ops-ahead-dev-kek

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=ops-ahead-dev
