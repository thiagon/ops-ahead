{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trigger-ml/v1",
  "title": "TriggerMlEvent",
  "description": "Message published to the trigger.ml Kafka topic by ui-gateway, consumed by ml-trainer's `consume` mode. Discriminated by `analysis` — the same business-language value ui-gateway received on POST /analyses, never translated into a separate internal vocabulary (see conductor/tracks/exec-trigger_20260807/payloads.md).",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/volumeForecast" },
    { "$ref": "#/definitions/entityForecast" },
    { "$ref": "#/definitions/breachRisk" },
    { "$ref": "#/definitions/kpiProjection" },
    { "$ref": "#/definitions/externalEventDetection" },
    { "$ref": "#/definitions/recurringCauses" }
  ],
  "definitions": {
    "volumeForecast": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id", "train_end", "validation_end", "holdout_end"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "volume_forecast" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "train_end": { "$ref": "#/definitions/splitDate" },
        "validation_end": { "$ref": "#/definitions/splitDate" },
        "holdout_end": { "$ref": "#/definitions/splitDate" }
      }
    },
    "entityForecast": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id", "train_end", "validation_end", "holdout_end"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "entity_forecast" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "train_end": { "$ref": "#/definitions/splitDate" },
        "validation_end": { "$ref": "#/definitions/splitDate" },
        "holdout_end": { "$ref": "#/definitions/splitDate" }
      }
    },
    "breachRisk": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id", "train_end", "validation_end", "holdout_end"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "breach_risk" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "train_end": { "$ref": "#/definitions/splitDate" },
        "validation_end": { "$ref": "#/definitions/splitDate" },
        "holdout_end": { "$ref": "#/definitions/splitDate" }
      }
    },
    "kpiProjection": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "kpi_projection" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "n_simulations": { "type": "integer", "minimum": 1, "description": "Monte Carlo draw count. ml-trainer's own configured default applies when omitted." },
        "seed": { "type": "integer", "description": "RNG seed for reproducibility. ml-trainer's own configured default applies when omitted." }
      }
    },
    "externalEventDetection": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "external_event_detection" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "contamination": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Expected share of days flagged anomalous. ml-trainer's own configured default applies when omitted." }
      }
    },
    "recurringCauses": {
      "type": "object",
      "required": ["run_id", "update_key", "analysis", "tenant_id"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "update_key": { "$ref": "#/definitions/updateKey" },
        "analysis": { "const": "recurring_causes" },
        "tenant_id": { "$ref": "#/definitions/tenantId" },
        "window_days": { "type": "integer", "minimum": 1, "description": "How much history describes an entity's behaviour. Unsupervised, so no split boundaries. ml-trainer's own configured default applies when omitted." }
      }
    },
    "tenantId": {
      "type": "string",
      "description": "Which tenant this training is for. One model per tenant, so a run without one has no owner \u2014 the trainer would not know which model to register, nor inference which to serve."
    },
    "runId": {
      "type": "string",
      "description": "Same run_id ui-gateway minted for POST /analyses (returned as `id` in the 202)."
    },
    "updateKey": {
      "type": "string",
      "description": "Credential for PATCH /analyses/{id}. Travels only on this message — never in the HTTP 202 — so only the consumer can update status."
    },
    "splitDate": {
      "type": "string",
      "format": "date",
      "description": "Temporal split boundary, YYYY-MM-DD. Always required — no hardcoded default (see docs/insights/temporal-split-data-dependency.md)."
    }
  }
}
