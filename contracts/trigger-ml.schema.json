{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trigger-ml/v1",
  "title": "TriggerMlEvent",
  "description": "Message published to the trigger.ml Kafka topic by ui-orchestrator, consumed by ml-trainer's `consume` mode. Discriminated by `analysis` — the same business-language value ui-orchestrator received on POST /trigger, never translated into a separate internal vocabulary (see conductor/tracks/exec-trigger_20260807/payloads.md).",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/volumeForecast" },
    { "$ref": "#/definitions/breachRisk" },
    { "$ref": "#/definitions/kpiProjection" },
    { "$ref": "#/definitions/externalEventDetection" }
  ],
  "definitions": {
    "volumeForecast": {
      "type": "object",
      "required": ["run_id", "analysis", "train_end", "validation_end", "holdout_end"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "analysis": { "const": "volume_forecast" },
        "train_end": { "$ref": "#/definitions/splitDate" },
        "validation_end": { "$ref": "#/definitions/splitDate" },
        "holdout_end": { "$ref": "#/definitions/splitDate" }
      }
    },
    "breachRisk": {
      "type": "object",
      "required": ["run_id", "analysis", "train_end", "validation_end", "holdout_end"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "analysis": { "const": "breach_risk" },
        "train_end": { "$ref": "#/definitions/splitDate" },
        "validation_end": { "$ref": "#/definitions/splitDate" },
        "holdout_end": { "$ref": "#/definitions/splitDate" }
      }
    },
    "kpiProjection": {
      "type": "object",
      "required": ["run_id", "analysis"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "analysis": { "const": "kpi_projection" },
        "n_simulations": { "type": "integer", "minimum": 1, "description": "Monte Carlo draw count. ml-trainer's own configured default applies when omitted." },
        "seed": { "type": "integer", "description": "RNG seed for reproducibility. ml-trainer's own configured default applies when omitted." },
        "kpi_target_volume_p2": { "type": "integer", "minimum": 0, "description": "Locaweb PPR target — business input, no default." },
        "kpi_target_volume_p3": { "type": "integer", "minimum": 0 },
        "kpi_target_breaches_p2": { "type": "integer", "minimum": 0 },
        "kpi_target_breaches_p3": { "type": "integer", "minimum": 0 }
      }
    },
    "externalEventDetection": {
      "type": "object",
      "required": ["run_id", "analysis"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "$ref": "#/definitions/runId" },
        "analysis": { "const": "external_event_detection" },
        "contamination": { "type": "number", "minimum": 0, "maximum": 0.5, "description": "Expected share of days flagged anomalous. ml-trainer's own configured default applies when omitted." }
      }
    },
    "runId": {
      "type": "string",
      "description": "Same run_id ui-orchestrator returned in the 202 response to POST /trigger."
    },
    "splitDate": {
      "type": "string",
      "format": "date",
      "description": "Temporal split boundary, YYYY-MM-DD. Always required — no hardcoded default (see docs/insights/temporal-split-data-dependency.md)."
    }
  }
}
